# All optional. Nothing here is required to run ingest/generate/eval with Claude Code CLI + Ollama.

# Where data/ lives (raw cache, parquet, ercot.duckdb)
# ERCOT_BENCH_DATA_DIR=./data

# ERCOT public API (free registration at https://apiexplorer.ercot.com).
# If set, forecast tables are pulled for the full history instead of the ~7-day public MIS window.
# ERCOT_API_USERNAME=
# ERCOT_API_PASSWORD=
# ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=

# OpenAI-compatible endpoint defaults (Ollama / vLLM)
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=ollama

# Optional API-key backends
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
